# 배포 도메인. 공유 링크 생성 등에 사용한다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase 프로젝트 URL과 publishable 키. 브라우저에 노출되어도 되는 값이며 RLS로 접근을 제한한다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 마이그레이션, 타입 생성, RLS 검증 스크립트에서만 사용하는 직접 연결 문자열.
# 애플리케이션 런타임에서는 사용하지 않는다. 절대 커밋하지 않는다.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 선택: Supabase 개인 액세스 토큰(sbp_...). 있으면 Docker 없이 `pnpm db:types`를 실행할 수 있다.
# SUPABASE_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# 터미널에서 직접 배포할 때
#
# `pnpm cf:build`는 프로덕션 빌드라 NEXT_PUBLIC_* 값이 번들에 그대로 박힌다.
# 이 파일의 NEXT_PUBLIC_SITE_URL이 localhost이면 배포된 공유 링크도 localhost를 가리킨다.
#
# 그래서 배포용 값은 `.env.production.local`에 따로 둔다. Next.js는 프로덕션 빌드에서
# `.env.production.local`을 `.env.local`보다 먼저 읽으므로 개발 설정을 건드리지 않는다.
#
#   # .env.production.local
#   NEXT_PUBLIC_SITE_URL=https://<배포 도메인>
#
# 이 파일도 커밋하지 않는다.
