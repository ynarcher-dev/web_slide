# 서버 렌더 결과의 대비값. 공유 링크는 브라우저의 실제 주소로 만들기 때문에
# 배포 도메인을 몰라도 되고, 이 값이 틀려도 사용자가 받는 링크에는 영향이 없다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase 프로젝트 URL과 publishable 키. 브라우저에 노출되어도 되는 값이며 RLS로 접근을 제한한다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 마이그레이션, 타입 생성, RLS 검증 스크립트에서만 사용하는 직접 연결 문자열.
# 애플리케이션 런타임에서는 사용하지 않는다. 절대 커밋하지 않는다.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 선택: Supabase 개인 액세스 토큰(sbp_...). 있으면 Docker 없이 `pnpm db:types`를 실행할 수 있다.
# SUPABASE_ACCESS_TOKEN=
